# Git ignore
.env
bin/
todo

# Node
node_modules/

# Python
venv/

# MacOS
.DS_Store

# Knowledge graph cache (local artefact, never committed)
.code-review-graph/

# Experiment outputs (disposable; testdata/golden_hashes.csv is NOT ignored)
runs*.csv
runs*.json
sweep*.csv
sweep*.json
out/
# Sidecars and aggregates the batch runner writes next to any --out path
*.config.json
*.cells.csv

# Agent-local memory (never committed)
# Machine-local Claude state. Everything is ignored EXCEPT the repo-root
# agent-memory, which is knowledge about this repo and has to travel with it.
# ⚠️ A .claude/ below the root is a store an agent made because a session's cwd
# was a subdirectory — same knowledge, invisible to the repo's own agent. Those
# stay ignored; consolidate their notes into the root store instead.
**/.claude/
!/.claude/
/.claude/*
!/.claude/agent-memory
